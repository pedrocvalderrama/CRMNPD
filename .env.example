# Copie para .env e ajuste. Nao commite o .env.
# No servidor da fabrica estes valores ja apontam para o Sisplan.

CRM_NPD_SECRET=troque-esta-chave
CRM_NPD_HOST=0.0.0.0
CRM_NPD_PORT=8089
CRM_NPD_FONTE=firebird

# Sisplan Firebird 3 — MANUAL_ACESSO_BANCO_SISPLAN.md
# O caminho do FDB e o caminho NO SERVIDOR Firebird, mesmo se o CRM rodar
# em outra maquina da rede.
SISPLAN_HOST=192.168.100.168
SISPLAN_PORT=3051
SISPLAN_DATABASE=C:\Sisplan\Base\14215F.FDB
SISPLAN_USER=SYSDBA
SISPLAN_PASSWORD=
SISPLAN_CHARSET=WIN1252

# DLL 64-bit do manual (fbclient_x64.dll). O cliente 32-bit do Sisplan nao serve.
# Coloque o arquivo na pasta do CRM ou:
# SISPLAN_FBCLIENT=C:\dev\auto_sisplan\fbclient_x64.dll

# Listener CDC (MANUAL_CDC_LOGS_SISPLAN.md): le LOG e LOG_ALTERACAO a cada
# N segundos e regrava so pedidos / faturamento / orcamentos que mudaram.
# SISPLAN_CDC_AUTO=1 sobe o ouvinte junto com o Flask (run.bat).
SISPLAN_CDC_AUTO=1
SISPLAN_CDC_INTERVAL=5
SISPLAN_CDC_BATCH=2000
# stale = recarrega o FDB se a base nao for de hoje (copia de ontem, outro PC).
# 1 = sempre na subida. 0 = nunca (so o ouvinte).
SISPLAN_SYNC_ON_START=stale

# Desenvolvimento na maquina do programador (copia local do FDB):
# SISPLAN_HOST=local
# SISPLAN_DATABASE=D:\dev npd\CRM NPD\base\14215F.FDB
# SISPLAN_CDC_AUTO=0
# SISPLAN_SYNC_ON_START=0
